{
  "id": "Core.U",
  "mcu": "STM32L422",
  "freq": "80 MHz",
  "arch": "M4",
  "bootloaders": ["uart", "i2c", "spi", "usb_dfu"],
  "features": {
    "system.init":  "verified",
    "system.led":   "verified",
    "system.tick":  "verified",
    "system.delay": "verified",
    "system.fault": { "status": "verified", "note": "Register dump over polled USB CDC + SOS blink. HardFault verified on Core.U.2 (projects/fault-test)" },

    "clocks.hsi":  "verified",
    "clocks.hse":  "na",
    "clocks.msi":  "compile",
    "clocks.pll":  "compile",

    "gpio.digital":  "verified",
    "gpio.exti":     "compile",
    "gpio.af":       "verified",
    "gpio.od_pull":  "verified",

    "uart.polling": "compile",
    "uart.irq":     "compile",
    "uart.lp":      "compile",

    "i2c.std":  "verified",
    "i2c.fast": "verified",
    "i2c.fmp":  "compile",

    "spi.master": "compile",

    "adc.raw":      "verified",
    "adc.mv":       "verified",
    "adc.temp":     "verified",
    "adc.res":      "compile",
    "adc.oversamp": "compile",
    "adc.cont":     "compile",
    "adc.dma":      "compile",

    "coregen.gpio":   "verified",
    "coregen.i2c":    "verified",
    "coregen.analog": { "status": "compile", "note": "Code generic; hw-verified on Core.W" },
    "coregen.spi":    "compile",
    "coregen.uart":   "compile",

    "conn.usb_cdc": "verified",
    "conn.dfu":     "verified",
    "conn.ble":     "na",
    "conn.ble_adv": "na",
    "conn.ble_gatt":"na",
    "conn.fdcan":   "na",

    "power.sleep":     { "status": "verified", "note": "WFI sleep, wakes on SysTick. Verified on Core.U.2 (projects/power-test)" },
    "power.stop":      { "status": "verified", "note": "Stop 1 + RTC wakeup + clock recovery to 80MHz PLL. USB re-enumerates after wake (projects/power-test)" },
    "power.standby":   { "status": "verified", "note": "Standby + RTC wakeup. Full reset on wake, standby flag detected (projects/power-test)" },
    "power.rtc_wake":  { "status": "verified", "note": "LSI-based RTC wakeup timer, tested from both Stop and Standby (projects/power-test)" },
    "power.exti_wake": "compile",

    "security.rng":  "none",
    "security.aes":  "none",
    "security.pka":  "na",
    "security.hash": "na",

    "spi.octo":       "na",
    "adv.i3c_ctrl":   "na",
    "adv.i3c_target": "na",
    "adv.dac":        "na"
  }
}
