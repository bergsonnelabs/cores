{
  "id": "Core.W",
  "mcu": "STM32WBA55",
  "freq": "100 MHz",
  "arch": "M33",
  "bootloaders": ["uart", "i2c", "spi"],
  "features": {
    "system.init":  "verified",
    "system.led":   "verified",
    "system.tick":  "verified",
    "system.delay": "verified",
    "system.fault": "verified",

    "clocks.hsi":  "verified",
    "clocks.hse":  "verified",
    "clocks.msi":  "na",
    "clocks.pll":  "verified",

    "gpio.digital":  "verified",
    "gpio.exti":     "verified",
    "gpio.af":       "verified",
    "gpio.od_pull":  "verified",

    "uart.polling": "verified",
    "uart.irq":     "compile",
    "uart.lp":      "compile",

    "timer.basic": "verified",
    "timer.pwm":   "compile",

    "i2c.std":  "verified",
    "i2c.fast": "verified",
    "i2c.fmp":  "na",

    "spi.master": { "status": "partial", "note": "APB7 clock + MODF bugs fixed; SPI v2 transfer sequence (CSTART/TSIZE) needs RM study — loopback times out on RXP" },

    "adc.raw":      "verified",
    "adc.mv":       "verified",
    "adc.temp":     { "status": "partial", "note": "Reads hardware sensor; OTP cal (0x0BFA07xx) not bus-accessible on WBA55 — uses datasheet typical constants, ~±15°C accuracy" },
    "adc.res":      { "status": "partial", "note": "12-bit hw-verified; 8 / 10-bit compile only" },
    "adc.oversamp": "verified",
    "adc.cont":     "verified",
    "adc.dma":      "verified",

    "coregen.gpio":   "verified",
    "coregen.i2c":    "verified",
    "coregen.analog": "verified",
    "coregen.spi":    "compile",
    "coregen.uart":   "compile",

    "power.sleep":   "verified",
    "power.stop":    "compile",
    "power.standby": "compile",

    "watchdog.iwdg": "compile",

    "conn.usb_cdc":  "na",
    "conn.usb_hid":  "na",
    "conn.usb_msc":  "na",
    "conn.dfu":      "na",
    "conn.ble":      "verified",
    "conn.ble_adv":  "verified",
    "conn.ble_gatt": "verified",
    "conn.fdcan":    "na",

    "security.rng":  "verified",
    "security.aes":  "verified",
    "security.pka":  "none",
    "security.hash": "na",

    "spi.octo":       "na",
    "adv.i3c_ctrl":   "na",
    "adv.i3c_target": "na",
    "adv.dac":        "na"
  }
}
