{
  "project": {
    "name": "val-multi-i2c",
    "core": "Core-H-1-a",
    "description": "Validation: Dual I2C buses (I2C1 + I2C3) and ADC DMA on Core.H"
  },
  "clock": "max",
  "pads": {
    "4": "I2C1.CLK",
    "5": "I2C1.DAT",
    "2": "I2C3.CLK",
    "3": "I2C3.DAT",
    "8": "ADC7+"
  },
  "interfaces": {
    "I2C1": { "speed": 400000 },
    "I2C3": { "speed": 100000 }
  }
}
