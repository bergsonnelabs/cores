{
  "project": {
    "name": "hw-drive-dc-h-pad",
    "core": "Core-U-1-a",
    "description": "Hardware validation: Drive.DC.H external PH/EN pad control with PWM speed"
  },
  "clock": "max",
  "pads": {
    "3": "TIM2.2",
    "9": "GPIO.OUT",
    "4": "I2C1.CLK",
    "5": "I2C1.DAT",
    "2": "I2C3.CLK",
    "8": "I2C3.DAT"
  },
  "interfaces": {
    "I2C1": { "speed": 400000 },
    "I2C3": { "speed": 400000 }
  },
  "tiles": [
    { "tile": "Display.RGBW",   "bus": "I2C1", "instance": 0 },
    { "tile": "Drive.DC.H",  "bus": "I2C3", "instance": 0 }
  ]
}
