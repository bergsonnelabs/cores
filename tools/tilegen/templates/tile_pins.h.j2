#define PAD_{{ pad.number }}_PIN        {{ pad.pin }}
{% elif pad.type == "power" %}
/* Pad {{ pad.number }}: power (no GPIO) */
{% else %}
/* Pad {{ pad.number }}: system/no GPIO */
{% endif %}
{% endfor %}

/* ---- System pads ---- */

{% if system_pads.get("SWCLK") %}
#define PAD_SWCLK          {{ system_pads.SWCLK }}
{% endif %}
{% if system_pads.get("SWDIO") %}
#define PAD_SWDIO          {{ system_pads.SWDIO }}
{% endif %}
{% if system_pads.get("BOOT0") %}
#define PAD_BOOT0          {{ system_pads.BOOT0 }}
{% endif %}
{% if system_pads.get("NRST") %}
#define PAD_NRST           {{ system_pads.NRST }}
{% endif %}
{% if system_pads.get("VPLUS") %}
#define PAD_VCC            {{ system_pads.VPLUS }}
{% endif %}
{% if system_pads.get("GND") %}
#define PAD_GND            {{ system_pads.GND }}
{% endif %}

/* ---- Pin bitmasks (for BSRR, ODR, IDR) ---- */

{% for pad in pads %}
{% if pad.port is not none %}
#define PAD_{{ pad.number }}_MASK       (1UL << {{ pad.pin }})
{% endif %}
{% endfor %}

