/**
 * tile_interfaces.h — Interface pin/AF defines for {{ tile_name }}
 *
 * AUTO-GENERATED by coregen from {{ source_file }}
 * JSON version {{ json_version }}, rev {{ tile_rev }}
 *
 * DO NOT EDIT — regenerate with:
 *   python3 tools/coregen/coregen.py tiles/{{ source_file }}
 */

#ifndef TILE_INTERFACES_H
#define TILE_INTERFACES_H

/*
 * For each interface instance, defines are generated for the
 * required (and common optional) signals:
 *
 *   <IFACE>_<SIGNAL>_PAD    — tile pad number
 *   <IFACE>_<SIGNAL>_PORT   — GPIO port (e.g., GPIOB)
 *   <IFACE>_<SIGNAL>_PIN    — GPIO pin number
 *   <IFACE>_<SIGNAL>_AF     — alternate function number
 *
 * Only signals with a known GPIO mapping and AF are included.
 */

{% for iface in interfaces %}
/* ---- {{ iface.name }} ({{ iface.type }}) ---- */
{% if iface.parameters.get("max_clock_speed") %}
/* Max clock: {{ iface.parameters.max_clock_speed }} */
{% endif %}

{% for sig in iface.signals %}
{% if sig.port is not none and sig.af is not none %}
#define {{ iface.name }}_{{ sig.signal }}_PAD     {{ sig.pad }}
#define {{ iface.name }}_{{ sig.signal }}_PORT    GPIO{{ sig.port }}
#define {{ iface.name }}_{{ sig.signal }}_PIN     {{ sig.pin }}
#define {{ iface.name }}_{{ sig.signal }}_AF      {{ sig.af }}
{% elif sig.port is not none %}
#define {{ iface.name }}_{{ sig.signal }}_PAD     {{ sig.pad }}
#define {{ iface.name }}_{{ sig.signal }}_PORT    GPIO{{ sig.port }}
#define {{ iface.name }}_{{ sig.signal }}_PIN     {{ sig.pin }}
/* AF: not specified in tile definition */
{% endif %}
{% endfor %}

{% endfor %}
#endif /* TILE_INTERFACES_H */
