/**
 * ble_contract.c — GENERATED from the project's BLE contract. Do not edit.
 *
 * Services are registered in declaration order, and ids come from the contract
 * verbatim. Append new services at the END of the contract: a trailing service
 * never shifts the attribute handles of the ones above it, so clients that have
 * already cached the GATT layout keep working.
 */
#include "ble_contract.h"
#include <string.h>   /* memcpy / strlen, for decoding writes */

void ble_contract_configure(void)
{
{% if ble_radio and ble_radio.tx_power is defined %}
    core_ble_set_tx_power({{ ble_radio.tx_power }});   /* 0 = -20dBm, 1 = 0dBm, 2 = +10dBm */
{% endif %}
{% if ble_radio and ble_radio.adv_min is defined %}
    core_ble_set_adv_interval({{ ble_radio.adv_min }}, {{ ble_radio.adv_max }});
{% endif %}
{% if ble_radio and ble_radio.pairing %}
    /* Just Works + bonding. Every characteristic now sits behind an encrypted
     * link, so a client must pair before it can read or write anything. */
    core_ble_enable_pairing();
{% endif %}
{% if not ble_radio or (ble_radio.tx_power is not defined and ble_radio.adv_min is not defined and not ble_radio.pairing) %}
    /* Nothing declared — the SDK defaults stand. */
{% endif %}
}

{% if ble_contract %}
{% for c in ble_contract.chars %}
core_ble_char_t ble_ch_{{ c.sym }};
{% endfor %}

/* ---- Weak write handlers ----
 * Defined weak here so the dispatchers below always link. Define the same
 * symbol in your own translation unit to take the write.
 */
{% for c in ble_contract.chars %}
{% if c.writable %}
{% if c.c_type %}
/* Scalar: the contract declares the width, so the handler takes the value
 * rather than a buffer. The dispatcher decodes it; a short write is dropped
 * instead of being padded into a plausible-looking wrong number. Multi-byte
 * fields are little-endian per the contract, which is also this MCU's order,
 * so the copy needs no swapping.
 *
 * The parameter is `int`, not the exact width. A Studio DSL handler overrides
 * this symbol from another translation unit, and the DSL's only integer type
 * lowers to `int` -- an exact-width prototype here would collide with that
 * definition and fail to link. Decoding still happens at the declared width,
 * so the value is right; it is only widened afterwards.
 *
 * One consequence worth knowing: a uint32 characteristic whose value exceeds
 * INT32_MAX arrives negative. The DSL has no unsigned type either, so this
 * loses nothing a DSL author could have expressed. */
__attribute__((weak)) void ble_{{ c.sym }}_on_write(int value)
{
    (void)value;
}

static void ble_dispatch_{{ c.sym }}(const uint8_t *data, uint16_t len, void *ctx)
{
    (void)ctx;
    {{ c.c_type }} decoded = 0;
    if (len < sizeof decoded) return;
    memcpy(&decoded, data, sizeof decoded);
    ble_{{ c.sym }}_on_write((int)decoded);
}
{% elif c.is_string %}
/* A GATT write is not NUL-terminated, so the dispatcher copies into a buffer
 * one byte longer than the declared length and terminates it. An over-long
 * write is truncated rather than dropped: the characteristic declares how much
 * it holds, and the client sent more than that. */
__attribute__((weak)) void ble_{{ c.sym }}_on_write(const char *value)
{
    (void)value;
}

static void ble_dispatch_{{ c.sym }}(const uint8_t *data, uint16_t len, void *ctx)
{
    (void)ctx;
    char value[{{ c.len }} + 1];
    if (len > {{ c.len }}) len = {{ c.len }};
    memcpy(value, data, len);
    value[len] = '\0';
    ble_{{ c.sym }}_on_write(value);
}
{% else %}
__attribute__((weak)) void ble_{{ c.sym }}_on_write(const uint8_t *data, uint16_t len)
{
    (void)data; (void)len;
}

static void ble_dispatch_{{ c.sym }}(const uint8_t *data, uint16_t len, void *ctx)
{
    (void)ctx;
    ble_{{ c.sym }}_on_write(data, len);
}
{% endif %}
{% endif %}
{% endfor %}

/* ---- Publish ---- */
{% for c in ble_contract.chars %}
{% if c.c_type %}
void ble_{{ c.sym }}_set({{ c.c_type }} value)
{
    core_ble_set_value(ble_ch_{{ c.sym }}, &value, sizeof value);
}
{% else %}
void ble_{{ c.sym }}_set(const void *data, uint16_t len)
{
    if (len > {{ c.len }}) len = {{ c.len }};
    core_ble_set_value(ble_ch_{{ c.sym }}, data, len);
}
{% if c.is_string %}
void ble_{{ c.sym }}_set_str(const char *s)
{
    size_t n = strlen(s);
    if (n > {{ c.len }}) n = {{ c.len }};
    core_ble_set_value(ble_ch_{{ c.sym }}, s, (uint16_t)n);
}
{% endif %}
{% endif %}
{% endfor %}

void ble_contract_build(void)
{
{% for s in ble_contract.services %}
{% if s.note %}
    /* {{ s.note }} */
{% endif %}
    core_ble_svc_t {{ s.sym }} = core_ble_add_service_{{ 'sig' if s.is_sig else 'id' }}("{{ s.name }}", {{ s.define }});
{% for c in s.characteristics %}
    ble_ch_{{ c.sym }} = core_ble_add_char_{{ 'sig' if c.is_sig else 'id' }}({{ s.sym }}, "{{ c.name }}", {{ c.define }},
        {{ c.access_expr }}, {{ c.size_expr }},
        {{ 'ble_dispatch_' + c.sym if c.writable else 'NULL' }}, NULL);
{% endfor %}

{% endfor %}
}
{% endif %}
