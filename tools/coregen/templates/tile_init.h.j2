/**
 * tile_init.h — Generated initialization API for {{ tile_name }}
 *
 * AUTO-GENERATED by coregen from {{ source_file }} + {{ project_file }}
 * Project: {{ project.name }}
 *
 * DO NOT EDIT — regenerate by rebuilding the project.
 */

#ifndef TILE_INIT_H
#define TILE_INIT_H
{% if i2c_buses %}

#include "hal_i2c.h"

/* ---- Auto-generated I2C handles ---- */
{% for bus in i2c_buses %}
extern hal_i2c_t {{ bus.handle }};
{% endfor %}
{% endif %}
{% if tiles_config %}

/* ---- Tile driver includes ---- */
#include "tiles_hal.h"
#include "tiles_hal_core.h"
{% for header in tile_driver_headers %}
#include "{{ header }}"
{% endfor %}

/* ---- Kiln HAL handles (one per bus used by tiles) ---- */
{% for bus in tile_hal_buses %}
extern tiles_hal_t {{ bus.hal_handle }};
{% endfor %}

/* ---- Tile instance handles ---- */
{% for tile in tiles_config %}
extern tile_t {{ tile.handle }};
{% endfor %}
{% endif %}

/**
 * Initialize the tile: clock tree, flash latency, configured pins,
 * and tile peripheral drivers (if declared).
 * Call this at the top of main() before using any peripherals.
 */
void tile_init(void);

/**
 * Initialize the clock tree only.
 * Sets up oscillator, PLL (if needed), flash wait states, bus prescalers,
 * and switches SYSCLK to the configured source.
 */
void tile_clock_init(void);

/**
 * Initialize the configured GPIO pins only.
 * Enables GPIO port clocks and sets pin modes/AF for all pins
 * assigned in project.json.
 */
void tile_pin_init(void);
{% if tiles_config %}

/**
 * Initialize tile peripheral drivers.
 * Sets up Kiln HAL bridges and calls find/init for each declared tile.
 * Called automatically by tile_init(), or call separately after
 * tile_clock_init() + tile_pin_init() if you need LED before drivers.
 */
void tile_drivers_init(void);
{% endif %}

#endif /* TILE_INIT_H */
