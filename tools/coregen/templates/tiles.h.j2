/**
 * tile_handles.h — Tile driver includes and instance handles for {{ project_name }}
 *
 * Initially generated by coregen. The section between coregen markers
 * is kept in sync with config.json automatically — add your own
 * tile-related defines outside the markers.
 *
 * Named tile_handles.h (not tiles.h) so it doesn't shadow kiln/tiles.h
 * in the compiler include path.
 */

#ifndef TILE_HANDLES_H
#define TILE_HANDLES_H

/* ---- coregen:begin ---- */
#include "tiles.h"
#include "tiles_pal.h"
#include "core_tiles.h"
{% for header in tile_driver_headers %}
#include "{{ header }}"
{% endfor %}

/* Tile PAL handles (one per bus used by tiles) */
{% for bus in tile_pal_buses %}
tiles_pal_t {{ bus.pal_handle }};
{% endfor %}

/* Tile instance handles */
{% for tile in tiles_config %}
tile_t {{ tile.handle }};
{% endfor %}
/* ---- coregen:end ---- */

#endif /* TILE_HANDLES_H */
