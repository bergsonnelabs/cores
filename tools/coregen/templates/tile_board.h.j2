#ifndef TILE_BOARD_H
#define TILE_BOARD_H

/* ---- Onboard LED ---- */

{% if led %}
#define LED_PORT           GPIO{{ led.port }}
#define LED_PIN            {{ led.pin }}
#define LED_MASK           (1UL << {{ led.pin }})
{% if led.active_high %}
#define LED_ACTIVE_HIGH    1
#define LED_ON()           (LED_PORT->BSRR = LED_MASK)
#define LED_OFF()          (LED_PORT->BSRR = (LED_MASK << 16))
{% else %}
#define LED_ACTIVE_HIGH    0
#define LED_ON()           (LED_PORT->BSRR = (LED_MASK << 16))
#define LED_OFF()          (LED_PORT->BSRR = LED_MASK)
{% endif %}
#define LED_TOGGLE()       (LED_PORT->ODR ^= LED_MASK)
{% else %}
/* No LED info found in application_notes */
{% endif %}

/* ---- Power ---- */

{% if power %}
{% if power.get("min") is not none %}
#define VCC_MIN            {{ "%.2f"|format(power.min) }}f
{% endif %}
{% if power.get("max") is not none %}
#define VCC_MAX            {{ "%.2f"|format(power.max) }}f
{% endif %}
{% if power.get("notes") and "3.0" in power.notes %}
#define VCC_USB_MIN        3.0f
{% endif %}
{% endif %}

#endif /* TILE_BOARD_H */
