      "signature": "core_rtc_set_alarm(uint8_t hours, uint8_t minutes, uint8_t seconds)",
      "returns": "void",
      "brief": "Set Alarm A to trigger at a specific time. Pass 0xFF for hours, minutes, or seconds to ignore that field. The alarm fires when all non-masked fields match the RTC time.",
