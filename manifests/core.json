  "hosts": [
    {
      "qname": [
        "led",
        "blink"
      ],
      "symbol": "core_led_blink",
      "header": "core_led.h",
      "category": "led",
      "description": "Blink the LED n times. Each cycle turns the LED on for on_ms milliseconds and off for off_ms milliseconds. Blocking — returns after the last off period.",
      "params": [
        {
          "name": "n",
          "type": "int",
          "range": [
            1,
            100
          ],
          "description": "Number of times to blink."
        },
        {
          "name": "on_ms",
          "type": "int",
          "range": [
            1,
            5000
          ],
          "unit": "ms",
          "description": "LED-on duration per blink."
        },
        {
          "name": "off_ms",
          "type": "int",
          "range": [
            1,
            5000
          ],
          "unit": "ms",
          "description": "LED-off duration per blink."
        }
      ],
      "returns": "void"
    },
    {
      "qname": [
        "led",
        "heartbeat"
      ],
      "symbol": "core_led_heartbeat",
      "header": "core_led.h",
      "category": "led",
      "description": "Toggle the LED and delay for period_ms. Call this in your main loop for a continuous alive indicator. Vary the period to signal different states (e.g., 50ms = fast/active, 500ms = idle).",
      "params": [
        {
          "name": "period_ms",
          "type": "int",
          "range": [
            0,
            60000
          ],
          "unit": "ms",
          "description": "Delay after the toggle. 0 toggles without waiting."
        }
      ],
      "returns": "void"
    },
    {
