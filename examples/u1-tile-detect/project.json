{
  "project": {
    "name": "u1-tile-detect",
    "core": "Core-U-1-a",
    "description": "I2C3 tile detection tester with RGBW LED indicator"
  },
  "clock": "max",
  "pads": {
    "4": "I2C1.CLK",
    "5": "I2C1.DAT",
    "2": "I2C3.CLK",
    "8": "I2C3.DAT"
  },
  "interfaces": {
    "I2C1": { "speed": 400000 },
    "I2C3": { "speed": 100000 }
  },
  "tiles": [
    { "tile": "Disp.RGBW", "bus": "I2C1", "instance": 0 }
  ],
  "bootloader": "custom"
}
