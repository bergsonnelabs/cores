{
  "project": {
    "name": "u1-sense-mic-stream",
    "core": "Core-U-1-a",
    "description": "Sense.MIC high-speed ADC streaming over USB CDC with live Python plotting"
  },
  "clock": "max",
  "pads": {
    "4": "I2C1.CLK",
    "5": "I2C1.DAT",
    "2": "I2C3.CLK",
    "8": "I2C3.DAT"
  },
  "interfaces": {
    "I2C1": { "speed": 400000 },
    "I2C3": { "speed": 1000000 }
  },
  "tiles": [
    { "tile": "Disp.RGBW", "bus": "I2C1", "instance": 0 },
    { "tile": "Sense.MIC", "bus": "I2C3", "instance": 0 }
  ]
}
