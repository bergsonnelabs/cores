{
  "project": {
    "name": "u1-sense-tof-test",
    "core": "Core-U-1-a",
    "description": "Hardware test: Sense.TOF (TMF8806) on I2C3 with Disp.RGBW on I2C1"
  },
  "clock": "max",
  "pads": {
    "4": "I2C1.CLK",
    "5": "I2C1.DAT",
    "2": "I2C3.CLK",
    "8": "I2C3.DAT"
  },
  "interfaces": {
    "I2C1": { "speed": 400000 },
    "I2C3": { "speed": 400000 }
  },
  "tiles": [
    { "tile": "Disp.RGBW", "bus": "I2C1", "instance": 0 },
    { "tile": "Sense.TOF", "bus": "I2C3", "instance": 0 }
  ],
  "bootloader": "custom",
  "usb": { "enabled": true }
}
